{
  "expo": {
    "name": "SimplyTrivia",
    "slug": "SimplyTrivia",
    "scheme": "simply-trivia",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidGradleMemory.js",
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#00159C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simplytrivia",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00159C"
      },
      "package": "com.simplytrivia"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c6beba07-bf63-446c-9869-ef7a2abde5ee"
      }
    }
  }
}
